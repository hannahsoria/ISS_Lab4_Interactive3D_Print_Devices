// start positions
int untouched1, untouched2, untouched3;

// threshold to track a touch
int threshold1, threshold2, threshold3;


// function that returns a calibration of the sensors
int calibrate(const int pin) {
  int total = 0;

  for(int i = 0; i < 30; i++){
    total += touchRead(pin);
  }
  int result = total / 30;
  return result;
}

void setup() {
  Serial.begin(9600);

  // initialize the OLED object
  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("SSD1306 allocation failed"));
    for (;;)
      ;  // Don't proceed, loop forever
    
  }

  // retrieve the value of the touch
  int moon = calibrate(TP_MOON);
  int fish = calibrate(TP_FISH);
  int star = calibrate(TP_STAR);

  // set the thresholds
  threshold1 = moon - 100;
  threshold2 = fish - 100;
  threshold3 = star - 100;
}


void loop() {

  // check the capacitive areas
  int star_sense = touchRead(TP_STAR);
  int fish_sense = touchRead(TP_FISH);
  int moon_sense = touchRead(TP_MOON);

  // "home screen" display
  display.clearDisplay();
  display.drawBitmap(0, 0, cat_arr, 128, 64, WHITE);
  display.display();
  
  // if star is pressed then display star graphics
  if (star_sense < threshold3){
    for (int i = 0; i < 2; i ++){
      display.clearDisplay();
      display.drawBitmap(0, 0, star1_arr, 128, 64, WHITE);
      display.display();
      delay(1000);
      display.clearDisplay();
      display.drawBitmap(0, 0, star2_arr, 128, 64, WHITE);
      display.display();
      delay(1000);
    }
  }

  // if the fish is pressed then displau fish graphics
  if (fish_sense < threshold2){
    for (int i = 0; i < 2; i ++) {
      display.clearDisplay();
      display.drawBitmap(0, 0, fish1_arr, 128, 64, WHITE);
      display.display();
      delay(1000);
      display.clearDisplay();
      display.drawBitmap(0, 0, fish2_arr, 128, 64, WHITE);
      display.display();
      delay(1000);
    }
  }

  // if moon is pressed display moon graphics
  if (moon_sense < threshold1){
    for (int i = 0; i < 2; i ++){
      display.clearDisplay();
      display.drawBitmap(0, 0, moon1_arr, 128, 64, WHITE);
      display.display();
      delay(1000);
      display.clearDisplay();
      display.drawBitmap(0, 0, moon2_arr, 128, 64, WHITE);
      display.display();
      delay(1000);
    }
  }




}